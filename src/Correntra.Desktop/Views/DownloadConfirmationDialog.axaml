<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Correntra.Desktop.ViewModels"
        xmlns:models="using:Correntra.Desktop.Models"
        x:Class="Correntra.Desktop.Views.DownloadConfirmationDialog"
        x:DataType="vm:DownloadConfirmationViewModel"
        x:CompileBindings="True"
        Classes="dialog"
        Title="{DynamicResource Dialog.Confirm.Title}"
        Icon="/Assets/correntra.ico"
        Width="730"
        Height="520">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource Corr.PanelRaised}"
            BorderBrush="{DynamicResource Corr.Border}"
            BorderThickness="0,0,0,1"
            Padding="24,18">
      <Grid ColumnDefinitions="54,*,Auto">
        <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource Corr.AccentMuted}">
          <PathIcon Data="{StaticResource Icon.Download}" Width="24" Height="24" Foreground="{DynamicResource Corr.Accent}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{DynamicResource Dialog.Confirm.Heading}" Classes="dialogHeading" />
          <TextBlock Text="{Binding FileName}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2"
                Background="{DynamicResource Corr.AccentMuted}"
                CornerRadius="8"
                Padding="10,5"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Corr.Accent}" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Grid Margin="24,18" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="128,*">
        <TextBlock Grid.Row="0" Text="{DynamicResource Dialog.Confirm.Source}" Classes="muted" Margin="0,8,12,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Url}" IsReadOnly="True" />

        <TextBlock Grid.Row="1" Text="{DynamicResource Dialog.Confirm.FileName}" Classes="muted" Margin="0,17,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FileName}" Margin="0,9,0,0" AutomationProperties.Name="{DynamicResource Dialog.Confirm.FileName}" />

        <TextBlock Grid.Row="2" Text="{DynamicResource Dialog.Confirm.Category}" Classes="muted" Margin="0,17,12,0" />
        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  Margin="0,9,0,0"
                  AutomationProperties.Name="{DynamicResource Dialog.Confirm.Category}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:LocalizedOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="{DynamicResource Dialog.Confirm.Destination}" Classes="muted" Margin="0,17,12,0" />
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
          <TextBox Text="{Binding Destination}" AutomationProperties.Name="{DynamicResource Dialog.Confirm.Destination}" />
          <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Common.Browse}" Click="OnBrowseClick" Margin="8,0,0,0" />
        </Grid>

        <CheckBox Grid.Row="4"
                  Grid.Column="1"
                  Content="{DynamicResource Dialog.Confirm.Remember}"
                  IsChecked="{Binding RememberForSite}"
                  Margin="0,16,0,0" />
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource Corr.TitleBackground}"
            BorderBrush="{DynamicResource Corr.Border}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Common.Cancel}" Click="OnCancelClick" IsCancel="True" Margin="0,0,8,0" />
        <Button Grid.Column="2" Classes="secondary" Content="{DynamicResource Dialog.Confirm.Later}" Click="OnLaterClick" Margin="0,0,8,0" />
        <Button Grid.Column="3" Classes="accent" Content="{DynamicResource Dialog.Confirm.Now}" Click="OnNowClick" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
