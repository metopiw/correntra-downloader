          <SolidColorBrush x:Key="Corr.Success">#45D39C</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.Selection">#2838D6AE</SolidColorBrush>
          <LinearGradientBrush x:Key="Corr.BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#55E7C0" Offset="0" />
            <GradientStop Color="#3B8FF5" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Corr.Background">#F2F5F8</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.TitleBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.Panel">#FFFFFF</SolidColorBrush>
