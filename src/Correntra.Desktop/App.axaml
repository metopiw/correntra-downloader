<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Correntra.Desktop.App"
             xmlns:local="using:Correntra.Desktop"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Corr.Background">#0B1018</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.TitleBackground">#090D14</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.Panel">#111823</SolidColorBrush>
