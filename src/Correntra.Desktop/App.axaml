          <SolidColorBrush x:Key="Corr.Border">#273548</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.BorderSubtle">#1D2938</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.TextPrimary">#F2F6FA</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.TextSecondary">#A8B4C3</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.TextMuted">#728094</SolidColorBrush>
          <SolidColorBrush x:Key="Corr.Accent">#38D6AE</SolidColorBrush>
