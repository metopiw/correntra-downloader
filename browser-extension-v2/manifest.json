{
  "manifest_version": 3,
  "name": "Correntra Catch",
  "short_name": "Catch",
  "version": "2.1.0",
  "key": "",
  "description": "Hands browser downloads to Correntra Downloader over a local bridge. No native messaging, no video capture.",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["http://127.0.0.1:27410/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Correntra Catch"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
